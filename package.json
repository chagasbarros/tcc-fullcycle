{
  "name": "tcc-fullcycle",
  "version": "0.1.0",
  "private": true,
  "description": "Marketplace (monólito modular) — TCC Fullcycle, Projeto A",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "worker": "tsx watch --env-file-if-exists=.env src/worker.ts",
    "start:worker": "node dist/worker.js",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "openapi:lint": "spectral lint docs/openapi.yaml --fail-severity=warn",
    "test:contract": "vitest run --config vitest.contract.config.ts consumer && vitest run --config vitest.contract.config.ts provider"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chagasbarros/tcc-fullcycle.git"
  },
  "author": "Chagas Barros",
  "license": "UNLICENSED",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@pact-foundation/pact": "^17.1.4",
    "@stoplight/spectral-cli": "^6.17.1",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.4.2",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.3",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bullmq": "^6.7.2",
    "fastify": "^5.12.8",
    "ioredis": "^6.0.0",
    "pino": "^10.4.0",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  }
}
