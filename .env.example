# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Local services from docker-compose.yml (development only credentials)
DATABASE_URL=postgresql://marketplace:marketplace@localhost:5432/marketplace
REDIS_URL=redis://localhost:6379

# Fake payment gateway latency in ms (ADR-0011)
PAYMENT_PROVIDER_LATENCY_MS=0

# Tracing (optional): set to send traces to Jaeger, e.g. after `docker compose up -d jaeger`
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=marketplace-api

# Feature flags (ADR-0015). Without UNLEASH_URL, flags come from the variables below.
# With the compose running, point to the local Unleash (local-only token):
# UNLEASH_URL=http://localhost:4242/api
# UNLEASH_API_TOKEN=default:development.local-dev-client-token
CATALOG_CACHE_ENABLED=true

# Render free plan only (ADR-0018): run the queue consumers inside the API process.
# Locally keep it false and run the worker separately (`npm run worker`, ADR-0010).
RUN_WORKER_IN_PROCESS=false
