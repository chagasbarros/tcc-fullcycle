# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Local services from docker-compose.yml (development only credentials)
DATABASE_URL=postgresql://marketplace:marketplace@localhost:5432/marketplace
REDIS_URL=redis://localhost:6379

# Fake payment gateway latency in ms (ADR-0011)
PAYMENT_PROVIDER_LATENCY_MS=0
