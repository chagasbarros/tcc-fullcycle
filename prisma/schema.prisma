// Each module owns its own PostgreSQL schema (ADR-0005):
//   catalog.*, orders.*, payments.*
// Rules: every model declares @@schema(...) and there are NO relations across schemas.
// Models are added together with each module's repositories.

generator client {
  provider = "prisma-client"
  output   = "../src/shared/db/generated"
}

datasource db {
  provider = "postgresql"
  schemas  = ["catalog", "orders", "payments"]
}

// ---------------------------------------------------------------------------
// catalog
// ---------------------------------------------------------------------------

model Product {
  /// UUID v7, generated by the application (CLAUDE.md, section 9).
  id           String   @id @db.Uuid
  name         String   @db.VarChar(200)
  /// Money in cents, never float.
  priceInCents Int      @map("price_in_cents")
  stock        Int
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("products")
  @@schema("catalog")
}

// ---------------------------------------------------------------------------
// orders
// ---------------------------------------------------------------------------

/// ADR-0007: only PENDING_PAYMENT can change; the others are final.
enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PAYMENT_FAILED
  CANCELLED

  @@schema("orders")
}

/// ADR-0011: chosen by the customer in POST /orders.
enum PaymentMethod {
  CARD
  PIX

  @@schema("orders")
}

model Order {
  id             String        @id @db.Uuid
  /// External identity (ADR-0008): no customers table.
  customerId     String        @map("customer_id") @db.Uuid
  status         OrderStatus
  paymentMethod  PaymentMethod @map("payment_method")
  /// Stored to avoid summing items on every read. Money in cents.
  totalInCents   Int           @map("total_in_cents")
  createdAt      DateTime      @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Idempotency-Key header of POST /orders (ADR-0016). NULL when the client sent none.
  idempotencyKey String?       @map("idempotency_key") @db.VarChar(255)
  items          OrderItem[]

  /// Same key twice for the same customer is impossible, even under concurrency.
  /// NULLs do not collide, so orders without a key are unaffected.
  @@unique([customerId, idempotencyKey])
  @@index([customerId])
  @@map("orders")
  @@schema("orders")
}

model OrderItem {
  orderId          String @map("order_id") @db.Uuid
  /// References catalog.products by id only: no FK across modules (ADR-0005).
  productId        String @map("product_id") @db.Uuid
  /// Snapshot at purchase time (ADR-0009).
  productName      String @map("product_name") @db.VarChar(200)
  unitPriceInCents Int    @map("unit_price_in_cents")
  quantity         Int
  order            Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@id([orderId, productId])
  @@map("order_items")
  @@schema("orders")
}

// ---------------------------------------------------------------------------
// payments
// ---------------------------------------------------------------------------

/// Same values as orders.PaymentMethod, but owned by payments (ADR-0005).
enum ChargeMethod {
  CARD
  PIX

  @@map("PaymentMethod")
  @@schema("payments")
}

enum PaymentStatus {
  APPROVED
  DECLINED

  @@schema("payments")
}

model Payment {
  id            String        @id @db.Uuid
  /// One payment per order: a redelivered queue job cannot create a second one.
  /// References orders.orders by id only: no FK across modules (ADR-0005).
  orderId       String        @unique @map("order_id") @db.Uuid
  method        ChargeMethod
  amountInCents Int           @map("amount_in_cents")
  status        PaymentStatus
  declineReason String?       @map("decline_reason") @db.VarChar(200)
  createdAt     DateTime      @map("created_at") @db.Timestamptz(3)

  @@map("payments")
  @@schema("payments")
}
